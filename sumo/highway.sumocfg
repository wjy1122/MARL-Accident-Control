<?xml version='1.0' encoding='UTF-8'?>
<configuration>
    <input>
        <net-file value="highway.net.xml" />
        <route-files value="highway.rou.xml" />
        <additional-files value="highway.add.xml" />
    </input>
    <time>
        <begin value="0" />
        <end value="3600" />
        <step-length value="0.1" />
    </time>
    <processing>
        <collision.action value="remove" />
        <time-to-teleport value="-1" />
    </processing>
    <random_number>
        <seed value="42" />
    </random_number>
    <report>
        <verbose value="false" />
        <no-warnings value="false" />
        <no-step-log value="true" />
    </report>
    <gui_only>
        <gui-settings-file value="highway.gui.xml" />
    </gui_only>
</configuration>